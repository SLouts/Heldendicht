# 從 Supabase 專案設定 > API 頁面複製這幾個值,存成 .env.local(不要 commit 這個檔案本身)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 只能在伺服器端使用,絕對不要加 NEXT_PUBLIC_ 前綴、絕對不要出現在任何 client bundle。
# 只有 src/lib/supabase/admin.ts(邀請碼註冊流程)會用到。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
